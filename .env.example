# TatzAI / elitetatz — environment variables
# Copy to .env.local and fill in. Never commit real values.

# --- Supabase ---------------------------------------------------------------
# Project URL (https://<ref>.supabase.co). Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable key. Public: shipped to the browser; RLS is the real guard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server only. Bypasses RLS; used by the admin client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---------------------------------------------------------------
# API key for the concierge agent (read by the Anthropic SDK).
ANTHROPIC_API_KEY=

# --- Stripe ------------------------------------------------------------------
# Secret key (sk_test_… / sk_live_…). Server only. On its own it changes
# nothing for clients: deposits stay on the shop's checkout until
# PLATFORM_DEPOSITS is also on.
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_test_… / pk_live_…). Public: used by Stripe.js in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to "on" to take deposits through Stripe with the 80/20 payout. Off by
# default: the pilot is lead generation and deposits go to the shop (AION).
PLATFORM_DEPOSITS=
# Shop checkout clients are sent to while platform deposits are off. Defaults
# to the artist's externalDepositUrl in src/lib/artists/lacey-rawson.ts.
ARTIST_EXTERNAL_DEPOSIT_URL=

# --- App ---------------------------------------------------------------------
# Canonical origin of this deployment, no trailing slash (e.g. https://app.rawsunart.com).
# Used to build absolute links in emails and Stripe return URLs.
NEXT_PUBLIC_APP_URL=

# --- Email (Resend) ----------------------------------------------------------
# Resend API key. Leave empty to disable sending (sends are best-effort).
RESEND_API_KEY=

# Cloudflare Turnstile (free bot check on the public forms). Checking is off
# until the secret is set. The site key is public and defaults to the live
# widget; the secret goes in Vercel only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: hostnames a token may come from (default: rawsunart.com, www, elitetatz.vercel.app)
TURNSTILE_HOSTNAMES=
# Default From header for transactional mail. Must be on a domain verified in
# Resend. Defaults to "RawSunArt <club@rawsunart.com>" when unset.
DEFAULT_FROM_EMAIL=
# From header for Collectors Club / community mail. Falls back to DEFAULT_FROM_EMAIL.
COMMUNITY_FROM_EMAIL=
# Where new-inquiry and deposit notifications for the artist are delivered.
ARTIST_NOTIFICATION_EMAIL=
# Optional second inbox (e.g. the operator). Gets a "something arrived" copy
# with a reference only; the client's details stay with the artist.
ARTIST_NOTIFICATION_CC=

# --- SMS (Dialpad) -----------------------------------------------------------
# Artist's mobile number for SMS heads-ups, E.164 (e.g. +16145550100).
ARTIST_SMS_NUMBER=
# Dialpad API token. Server only. Leave empty to disable SMS.
DIALPAD_API_TOKEN=
# Dialpad number the SMS is sent from, E.164.
DIALPAD_FROM_NUMBER=

# --- Security ----------------------------------------------------------------
# Secret used to sign match/deposit tokens in links. Generate with:
#   openssl rand -hex 32
MATCH_TOKEN_SECRET=

# --- Pilot mode --------------------------------------------------------------
# Any non-empty value (other than 0/false/off/no) closes public account
# sign-up: /auth/signup redirects to /auth/login. Set it in production.
SINGLE_ARTIST_MODE=

# --- Google (artist sign-in + Gmail/Calendar connection) ---------------------
# OAuth client from Google Cloud Console (type: Web application). Authorized
# redirect URIs: https://<supabase-ref>.supabase.co/auth/v1/callback (sign-in,
# configured in Supabase Auth) and <NEXT_PUBLIC_APP_URL>/api/artist/google/callback
# (Gmail/Calendar connection). Server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts stored refresh tokens. Server only.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_KEY=

# --- Lead inbox: inbound channels (docs/LEAD-INBOX-2026-11-03.md) -----------
# Every one of these is optional. A channel whose variables are empty simply
# does not deliver into the inbox; the web form and concierge always do.
# Nothing here sends anything to a client: inbound only.

# Email → inbox. In Resend: Receiving → add a domain or subdomain (e.g.
# inbox.rawsunart.com, MX record), then Webhooks → endpoint
# <NEXT_PUBLIC_APP_URL>/api/inbound/email, event `email.received`. The signing
# secret (whsec_…) goes here. INBOUND_EMAIL_ADDRESS is the address Lacey
# auto-forwards her inquiries to (mail from her own addresses is read only
# when it wraps a forwarded message).
#
# The same address is also put beside the client's in the Reply-To of every
# email we send her about a client, so when she answers from her mail app the
# portal gets a copy, records it as her answer and stops the hold timers. The
# client sees this address on the To line of her reply, so use one that reads
# well (inbox@…). Her reply always reaches the client directly; this is a copy.
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_ADDRESS=
# Set to "off" to send her replies to the client alone (no copy to the portal).
REPLY_SYNC=

# Instagram DMs and Messenger → inbox, through Chatwoot (app.chatwoot.com or
# self-hosted). Connect the Instagram and Facebook inboxes in Chatwoot, then
# Settings → Integrations → Webhooks: URL
# <NEXT_PUBLIC_APP_URL>/api/inbound/chatwoot?key=<CHATWOOT_WEBHOOK_SECRET>,
# event `message_created`. The API token is an agent's access token (Profile →
# Access Token); replies from the inbox go back through it.
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# Texts → inbox. Create a Dialpad webhook (POST /api/v2/webhooks, hook_url
# <NEXT_PUBLIC_APP_URL>/api/inbound/sms, secret = this value) and an SMS
# event subscription on it (direction inbound). Replies use DIALPAD_API_TOKEN above.
DIALPAD_WEBHOOK_SECRET=

# The assistant in the inbox (reads the lead, drafts, never sends).
# Model id; defaults to claude-opus-5-5 with claude-sonnet-4-6 as fallback.
ASSISTANT_MODEL=

# Google Business "write a review" short link. When set, booked leads whose
# appointment has passed get an "Ask for a review" button; it sends only on tap.
GOOGLE_REVIEW_URL=

# --- Approvals (docs/LEAD-INBOX-2026-11-03.md, "Approvals") -----------------
# Shared secret for POST/GET /api/approvals, used by scripts/submit-approval.mjs
# and by the Reconnect send script to check her decision. Generate with:
#   openssl rand -hex 32
# Set the same value here (Vercel) and in the operator's .env.local.
OPERATOR_API_KEY=
# Where "Lacey approved X" / "asked for changes" lands, and where every failed
# artist email or portal write is reported within the same request (see
# src/lib/alert.ts). Falls back to ARTIST_NOTIFICATION_CC.
OPERATOR_EMAIL=
# Optional Slack incoming webhook for the same alerts and the hold-timer
# "your move" lines. Independent of Resend, so it still fires when email is down.
SLACK_FOLLOWUPS_WEBHOOK=

# --- Demo pages ---------------------------------------------------------------
# /demo/inbox and /demo/approvals show made-up leads. Hidden in production unless
# this is 1, so the artist never sees data that is not hers.
SHOW_DEMO=
