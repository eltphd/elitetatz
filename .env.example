# TatzAI / elitetatz — environment variables
# Copy to .env.local and fill in. Never commit real values.

# --- Supabase ---------------------------------------------------------------
# Project URL (https://<ref>.supabase.co). Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable key. Public: shipped to the browser; RLS is the real guard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Server only. Bypasses RLS; used by the admin client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---------------------------------------------------------------
# API key for the concierge agent (read by the Anthropic SDK).
ANTHROPIC_API_KEY=

# --- Stripe ------------------------------------------------------------------
# Secret key (sk_test_… / sk_live_…). Server only.
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_test_… / pk_live_…). Public: used by Stripe.js in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- App ---------------------------------------------------------------------
# Canonical origin of this deployment, no trailing slash (e.g. https://app.rawsunart.com).
# Used to build absolute links in emails and Stripe return URLs.
NEXT_PUBLIC_APP_URL=

# --- Email (Resend) ----------------------------------------------------------
# Resend API key. Leave empty to disable sending (sends are best-effort).
RESEND_API_KEY=
# Default From header for transactional mail. Must be on a domain verified in
# Resend. Defaults to "RawSunArt <club@rawsunart.com>" when unset.
DEFAULT_FROM_EMAIL=
# From header for Collectors Club / community mail. Falls back to DEFAULT_FROM_EMAIL.
COMMUNITY_FROM_EMAIL=
# Where new-inquiry and deposit notifications for the artist are delivered.
ARTIST_NOTIFICATION_EMAIL=

# --- SMS (Dialpad) -----------------------------------------------------------
# Artist's mobile number for SMS heads-ups, E.164 (e.g. +16145550100).
ARTIST_SMS_NUMBER=
# Dialpad API token. Server only. Leave empty to disable SMS.
DIALPAD_API_TOKEN=
# Dialpad number the SMS is sent from, E.164.
DIALPAD_FROM_NUMBER=

# --- Security ----------------------------------------------------------------
# Secret used to sign match/deposit tokens in links. Generate with:
#   openssl rand -hex 32
MATCH_TOKEN_SECRET=

# --- Pilot mode --------------------------------------------------------------
# Set to the artist mode key (e.g. "lacey") to run the app as a single artist's
# funnel. Any non-empty value (other than 0/false/off/no) also makes the proxy
# redirect every marketplace route to /rawsunart. Leave empty for the
# multi-artist marketplace.
SINGLE_ARTIST_MODE=
